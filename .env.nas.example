# 复制为 .env 后再由群晖 Container Manager 构建项目。
# 密码会进入 PostgreSQL 连接字符串，请只使用大小写字母和数字。
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
# 使用 `openssl rand -base64 48` 生成；不要与数据库密码复用。
AUTH_SECURITY_HASH_SECRET=replace_with_a_long_random_secret
POSTGRES_DATA_PATH=/volume1/docker/family-finance/postgres
WEB_PORT=5173
# 登录失败限流状态写入 PostgreSQL；不应使用临时容器或内存数据库。

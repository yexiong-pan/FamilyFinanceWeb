generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
}

enum TransactionKind {
  expense
  income
  transfer
  adjustment
}

enum TransactionSource {
  manual
  alipay
  wechat
}

enum InvestmentHoldingType {
  fund
  stock
  etf
}

enum LiabilityType {
  mortgage
  carLoan
  consumerInstallment
  creditCard
  privateLoan
  other
}

enum LiabilityStatus {
  active
  paidOff
  closed
}

enum LiabilityRepaymentSchedule {
  monthly
  flexible
}

enum MortgageLoanPartKind {
  commercial
  providentFund
}

enum MortgageRateType {
  fixed
  lprFloating
  providentFundPolicy
}

enum MortgageRepaymentMethod {
  equalPrincipalAndInterest
  equalPrincipal
}

enum MortgageRateSource {
  contract
  lprRepricing
  shanghaiProvidentFundPolicy
  bankNotice
  manualCorrection
}

enum MortgageRepaymentSource {
  bankStatement
  manual
}

enum ProvidentFundContributionSource {
  annualAdjustment
  employmentChange
  manualCorrection
}

enum MortgageProvidentFundRole {
  borrower
  spouse
  parentChild
}

enum MortgageMonthlyRepaymentStatus {
  confirmed
}

enum ProvidentFundAccountTransactionType {
  monthlyContribution
  monthlyOffset
}

enum ExpenseNature {
  fixed
  necessary
  flexible
  goal
}

enum AssetPurpose {
  daily
  emergency
  goal
  investment
  restricted
}

enum ExerciseIntensity {
  low
  moderate
  high
}

enum StrengthMovementMetric {
  reps
  seconds
}

enum BodyMeasurementContext {
  morningFasting
  other
}

enum GlucoseContext {
  fasting
  beforeMeal
  afterMeal1h
  afterMeal2h
  bedtime
  random
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum ExerciseRelation {
  before
  after
}

enum GlucoseSource {
  manual
  meter
  cgm
}

enum MedicationPlanStatus {
  active
  paused
  stopped
}

enum MedicationDoseStatus {
  taken
  missed
  paused
}

enum MedicationAdministrationRoute {
  oral
  injection
  topical
  other
}

enum MedicationFrequency {
  daily
  weekly
  interval
}

enum MedicationInventoryEventType {
  initial
  restock
  adjustment
  consumption
}

enum HealthFollowupStatus {
  scheduled
  completed
  cancelled
}

enum CalendarEventType {
  schedule
  anniversary
}

enum CalendarSystem {
  solar
  lunar
}

enum CalendarRecurrence {
  none
  daily
  weekly
  monthly
  yearly
}

enum CalendarEventStatus {
  scheduled
  completed
  cancelled
}

enum MonthlyActionStatus {
  pending
  completed
  cancelled
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  displayName  String
  avatarData   String?
  passwordHash String
  isActive     Boolean        @default(true)
  role         UserRole       @default(OWNER)
  memberships  FamilyMember[]
  sessions     AuthSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthInvitation {
  id        String    @id @default(uuid())
  familyId  String
  memberId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([familyId, memberId])
}

// Short-lived, hashed keys used to enforce authentication rate limits across API restarts.
// Neither passwords, email addresses nor IP addresses are stored in this table.
model AuthRateLimit {
  id              String    @id @default(uuid())
  scope           String
  keyHash         String
  failureCount    Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([scope, keyHash])
  @@index([expiresAt])
}

// Security events are deliberately separate from the family activity log so failed
// attempts for unknown accounts can be retained without creating a family relation.
model AuthSecurityEvent {
  id           String   @id @default(uuid())
  action       String
  subjectHash  String?
  sourceIpHash String?
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([action, createdAt])
  @@index([subjectHash, createdAt])
}

model Family {
  id                    String                     @id @default(uuid())
  name                  String
  members               FamilyMember[]
  accounts              Account[]
  accountTypes          AccountTypeOption[]
  categories            Category[]
  transactions          FinanceTransaction[]
  budgets               Budget[]
  holdings              InvestmentHolding[]
  liabilities           Liability[]
  liabilityRepayments   LiabilityRepayment[]
  snapshots             AccountSnapshot[]
  liabilitySnapshots    LiabilitySnapshot[]
  investmentSnapshots   InvestmentSnapshot[]
  monthlyReviews        MonthlyReview[]
  auditLogs             AuditLog[]
  importJobs            ImportJob[]
  categoryMappings      CategoryMapping[]
  recurringCashflows    RecurringCashflow[]
  safetySettings        FinancialSafetySettings?
  monthlyActions        MonthlyReviewAction[]
  healthProfiles        MemberHealthProfile[]
  bodyMeasurements      BodyMeasurement[]
  exerciseLogs          ExerciseLog[]
  glucoseRecords        BloodGlucoseRecord[]
  hba1cRecords          Hba1cRecord[]
  healthReviews         WeeklyHealthReview[]
  medicationPlans       MedicationPlan[]
  medicationDoses       MedicationDoseRecord[]
  medicationInventory   MedicationInventoryEvent[]
  healthFollowups       HealthFollowup[]
  calendarEvents        CalendarEvent[]
  mortgages             Mortgage[]
  providentFundAccounts ProvidentFundAccount[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
}

model FamilyMember {
  id                    String                     @id @default(uuid())
  familyId              String
  userId                String?
  name                  String
  icon                  String?
  role                  UserRole                   @default(OWNER)
  family                Family                     @relation(fields: [familyId], references: [id])
  user                  User?                      @relation(fields: [userId], references: [id])
  healthProfile         MemberHealthProfile?
  bodyMeasurements      BodyMeasurement[]
  exerciseLogs          ExerciseLog[]
  glucoseRecords        BloodGlucoseRecord[]
  hba1cRecords          Hba1cRecord[]
  healthReviews         WeeklyHealthReview[]
  medicationPlans       MedicationPlan[]
  medicationDoses       MedicationDoseRecord[]
  healthFollowups       HealthFollowup[]
  calendarEvents        CalendarEventParticipant[]
  providentFundAccounts ProvidentFundAccount[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([familyId, name])
}

model Account {
  id                 String               @id @default(uuid())
  familyId           String
  name               String
  type               String
  purpose            AssetPurpose?
  ownerName          String
  currentValue       Decimal              @db.Decimal(18, 2)
  cashBalance        Decimal              @default(0) @db.Decimal(18, 2)
  note               String?
  deletedAt          DateTime?
  family             Family               @relation(fields: [familyId], references: [id])
  transactions       FinanceTransaction[]
  holdings           InvestmentHolding[]
  recurringCashflows RecurringCashflow[]
  snapshots          AccountSnapshot[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model AccountTypeOption {
  id        String   @id @default(uuid())
  familyId  String
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  family    Family   @relation(fields: [familyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([familyId, name])
}

model Category {
  id                 String               @id @default(uuid())
  familyId           String
  name               String
  kind               TransactionKind
  note               String?
  expenseNature      ExpenseNature?
  isDefault          Boolean              @default(false)
  isActive           Boolean              @default(true)
  family             Family               @relation(fields: [familyId], references: [id])
  transactions       FinanceTransaction[]
  budgets            Budget[]
  sourceMappings     CategoryMapping[]
  recurringCashflows RecurringCashflow[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([familyId, name, kind])
}

model FinanceTransaction {
  id              String             @id @default(uuid())
  familyId        String
  accountId       String?
  categoryId      String?
  date            DateTime
  kind            TransactionKind
  categoryName    String
  memberName      String
  amount          Decimal            @db.Decimal(18, 2)
  note            String?
  source          TransactionSource?
  sourceCategory  String?
  sourceRecordKey String?
  confirmedAt     DateTime?
  deletedAt       DateTime?
  family          Family             @relation(fields: [familyId], references: [id])
  account         Account?           @relation(fields: [accountId], references: [id])
  category        Category?          @relation(fields: [categoryId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([familyId, sourceRecordKey])
}

model CategoryMapping {
  id               String            @id @default(uuid())
  familyId         String
  source           TransactionSource
  kind             TransactionKind
  sourceCategory   String
  targetCategoryId String
  family           Family            @relation(fields: [familyId], references: [id])
  targetCategory   Category          @relation(fields: [targetCategoryId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([familyId, source, kind, sourceCategory])
}

model Budget {
  id           String    @id @default(uuid())
  familyId     String
  categoryId   String?
  month        String
  categoryName String
  limitAmount  Decimal   @db.Decimal(18, 2)
  family       Family    @relation(fields: [familyId], references: [id])
  category     Category? @relation(fields: [categoryId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([familyId, month, categoryName])
}

model InvestmentHolding {
  id             String                @id @default(uuid())
  familyId       String
  accountId      String
  name           String
  code           String
  type           InvestmentHoldingType
  marketValue    Decimal               @db.Decimal(18, 2)
  investedAmount Decimal?              @db.Decimal(18, 2)
  profit         Decimal               @db.Decimal(18, 2)
  note           String?
  deletedAt      DateTime?
  family         Family                @relation(fields: [familyId], references: [id])
  account        Account               @relation(fields: [accountId], references: [id])
  snapshots      InvestmentSnapshot[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model Liability {
  id                String                     @id @default(uuid())
  familyId          String
  name              String
  type              LiabilityType
  ownerName         String
  initialBalance    Decimal?                   @db.Decimal(18, 2)
  currentBalance    Decimal                    @db.Decimal(18, 2)
  monthlyPayment    Decimal?                   @db.Decimal(18, 2)
  paymentDay        Int?
  repaymentSchedule LiabilityRepaymentSchedule @default(monthly)
  remainingPeriods  Int?
  lender            String?
  status            LiabilityStatus            @default(active)
  note              String?
  deletedAt         DateTime?
  family            Family                     @relation(fields: [familyId], references: [id])
  snapshots         LiabilitySnapshot[]
  repayments        LiabilityRepayment[]
  mortgage          Mortgage?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
}

model Mortgage {
  id                        String                             @id @default(uuid())
  familyId                  String
  liabilityId               String                             @unique
  name                      String
  lender                    String?
  repaymentDay              Int
  note                      String?
  deletedAt                 DateTime?
  family                    Family                             @relation(fields: [familyId], references: [id])
  liability                 Liability                          @relation(fields: [liabilityId], references: [id])
  loanParts                 MortgageLoanPart[]
  providentFundParticipants MortgageProvidentFundParticipant[]
  monthlyRepayments         MortgageMonthlyRepayment[]
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt

  @@index([familyId, deletedAt])
}

model MortgageLoanPart {
  id                   String                      @id @default(uuid())
  mortgageId           String
  kind                 MortgageLoanPartKind
  name                 String
  initialPrincipal     Decimal                     @db.Decimal(18, 2)
  outstandingPrincipal Decimal                     @db.Decimal(18, 2)
  rateType             MortgageRateType
  occupancyType        String?
  lprSpread            Decimal?                    @db.Decimal(8, 4)
  repricingCycleMonths Int?
  repricingDate        DateTime?
  repaymentMethod      MortgageRepaymentMethod
  firstRepaymentDate   DateTime
  totalPeriods         Int
  remainingPeriods     Int
  mortgage             Mortgage                    @relation(fields: [mortgageId], references: [id], onDelete: Cascade)
  rateVersions         MortgageLoanRateVersion[]
  actualRepayments     MortgageLoanPartRepayment[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([mortgageId])
}

model MortgageLoanRateVersion {
  id                String             @id @default(uuid())
  loanPartId        String
  annualRate        Decimal            @db.Decimal(8, 4)
  effectiveDate     DateTime
  source            MortgageRateSource
  lprValue          Decimal?           @db.Decimal(8, 4)
  lprPublishedMonth String?
  policyVersion     String?
  evidenceNote      String?
  loanPart          MortgageLoanPart   @relation(fields: [loanPartId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())

  @@unique([loanPartId, effectiveDate])
  @@index([loanPartId, effectiveDate])
}

model MortgageLoanPartRepayment {
  id                 String                    @id @default(uuid())
  loanPartId         String
  monthlyRepaymentId String?
  sequence           Int
  dueDate            DateTime
  principal          Decimal                   @db.Decimal(18, 2)
  interest           Decimal                   @db.Decimal(18, 2)
  source             MortgageRepaymentSource   @default(bankStatement)
  note               String?
  loanPart           MortgageLoanPart          @relation(fields: [loanPartId], references: [id], onDelete: Cascade)
  monthlyRepayment   MortgageMonthlyRepayment? @relation(fields: [monthlyRepaymentId], references: [id], onDelete: SetNull)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([loanPartId, sequence])
  @@index([loanPartId, dueDate])
  @@index([monthlyRepaymentId])
}

model MortgageMonthlyRepayment {
  id                        String                            @id @default(uuid())
  mortgageId                String
  month                     String
  dueDate                   DateTime
  status                    MortgageMonthlyRepaymentStatus    @default(confirmed)
  totalAmount               Decimal                           @db.Decimal(18, 2)
  providentFundOffset       Decimal                           @default(0) @db.Decimal(18, 2)
  selfFundAmount            Decimal                           @default(0) @db.Decimal(18, 2)
  note                      String?
  confirmedAt               DateTime                          @default(now())
  mortgage                  Mortgage                          @relation(fields: [mortgageId], references: [id], onDelete: Cascade)
  loanPartRepayments        MortgageLoanPartRepayment[]
  providentFundTransactions ProvidentFundAccountTransaction[]
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt

  @@unique([mortgageId, month])
  @@index([mortgageId, dueDate])
}

model ProvidentFundAccount {
  id                               String                             @id @default(uuid())
  familyId                         String
  memberId                         String
  basicBalance                     Decimal                            @default(0) @db.Decimal(18, 2)
  supplementaryBalance             Decimal                            @default(0) @db.Decimal(18, 2)
  basicMonthlyContribution         Decimal?                           @db.Decimal(18, 2)
  supplementaryMonthlyContribution Decimal?                           @db.Decimal(18, 2)
  monthlyContributionDay           Int                                @default(11)
  balanceUpdatedOn                 DateTime
  isActive                         Boolean                            @default(true)
  note                             String?
  family                           Family                             @relation(fields: [familyId], references: [id])
  member                           FamilyMember                       @relation(fields: [memberId], references: [id])
  contributionRates                ProvidentFundContributionRate[]
  transactions                     ProvidentFundAccountTransaction[]
  mortgageParticipants             MortgageProvidentFundParticipant[]
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @updatedAt

  @@unique([familyId, memberId])
  @@index([familyId, isActive])
}

model MortgageProvidentFundParticipant {
  id         String                    @id @default(uuid())
  mortgageId String
  accountId  String
  role       MortgageProvidentFundRole
  priority   Int
  isActive   Boolean                   @default(true)
  mortgage   Mortgage                  @relation(fields: [mortgageId], references: [id], onDelete: Cascade)
  account    ProvidentFundAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@unique([mortgageId, accountId])
  @@unique([mortgageId, priority])
  @@index([accountId])
}

model ProvidentFundContributionRate {
  id                               String                          @id @default(uuid())
  accountId                        String
  effectiveMonth                   String
  basicMonthlyContribution         Decimal                         @default(0) @db.Decimal(18, 2)
  supplementaryMonthlyContribution Decimal                         @default(0) @db.Decimal(18, 2)
  source                           ProvidentFundContributionSource
  note                             String?
  account                          ProvidentFundAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt                        DateTime                        @default(now())
  updatedAt                        DateTime                        @updatedAt

  @@unique([accountId, effectiveMonth])
  @@index([accountId, effectiveMonth])
}

model ProvidentFundAccountTransaction {
  id                         String                              @id @default(uuid())
  accountId                  String
  mortgageMonthlyRepaymentId String?
  month                      String
  date                       DateTime
  type                       ProvidentFundAccountTransactionType
  basicAmount                Decimal                             @default(0) @db.Decimal(18, 2)
  supplementaryAmount        Decimal                             @default(0) @db.Decimal(18, 2)
  note                       String?
  account                    ProvidentFundAccount                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mortgageMonthlyRepayment   MortgageMonthlyRepayment?           @relation(fields: [mortgageMonthlyRepaymentId], references: [id], onDelete: SetNull)
  createdAt                  DateTime                            @default(now())

  @@unique([accountId, mortgageMonthlyRepaymentId, type])
  @@index([accountId, month, type])
}

model LiabilityRepayment {
  id            String    @id @default(uuid())
  familyId      String
  liabilityId   String
  date          DateTime
  amount        Decimal   @db.Decimal(18, 2)
  note          String?
  appliedToLive Boolean   @default(false)
  createdAt     DateTime  @default(now())
  family        Family    @relation(fields: [familyId], references: [id])
  liability     Liability @relation(fields: [liabilityId], references: [id])

  @@index([familyId, date])
  @@index([liabilityId, date])
}

model LiabilitySnapshot {
  id                String                     @id @default(uuid())
  familyId          String
  liabilityId       String
  month             String
  currentBalance    Decimal                    @db.Decimal(18, 2)
  monthlyPayment    Decimal?                   @db.Decimal(18, 2)
  paymentDay        Int?
  repaymentSchedule LiabilityRepaymentSchedule @default(monthly)
  status            LiabilityStatus            @default(active)
  remainingPeriods  Int?
  confirmedAt       DateTime                   @default(now())
  family            Family                     @relation(fields: [familyId], references: [id])
  liability         Liability                  @relation(fields: [liabilityId], references: [id])

  @@unique([liabilityId, month])
  @@index([familyId, month])
}

model InvestmentSnapshot {
  id             String            @id @default(uuid())
  familyId       String
  holdingId      String
  month          String
  investedAmount Decimal           @db.Decimal(18, 2)
  marketValue    Decimal           @db.Decimal(18, 2)
  confirmedAt    DateTime          @default(now())
  family         Family            @relation(fields: [familyId], references: [id])
  holding        InvestmentHolding @relation(fields: [holdingId], references: [id])

  @@unique([holdingId, month])
  @@index([familyId, month])
}

model MonthlyReview {
  id                     String                @id @default(uuid())
  familyId               String
  month                  String
  incomeConfirmedAt      DateTime?
  spendingConfirmedAt    DateTime?
  assetsConfirmedAt      DateTime?
  liabilitiesConfirmedAt DateTime?
  investmentsConfirmedAt DateTime?
  reviewCompletedAt      DateTime?
  summary                String?
  good                   String?
  improve                String?
  nextFocus              String?
  family                 Family                @relation(fields: [familyId], references: [id])
  actions                MonthlyReviewAction[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([familyId, month])
}

model RecurringCashflow {
  id            String          @id @default(uuid())
  familyId      String
  name          String
  kind          TransactionKind
  amount        Decimal         @db.Decimal(18, 2)
  dayOfMonth    Int
  memberName    String?
  accountId     String?
  categoryId    String?
  expenseNature ExpenseNature?
  startMonth    String?
  endMonth      String?
  isActive      Boolean         @default(true)
  family        Family          @relation(fields: [familyId], references: [id])
  account       Account?        @relation(fields: [accountId], references: [id])
  category      Category?       @relation(fields: [categoryId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([familyId, isActive])
  @@index([familyId, kind])
}

model FinancialSafetySettings {
  id                    String   @id @default(uuid())
  familyId              String   @unique
  emergencyReserve      Decimal  @default(0) @db.Decimal(18, 2)
  plannedMonthlySavings Decimal  @default(0) @db.Decimal(18, 2)
  liquidAccountIds      String[] @default([])
  family                Family   @relation(fields: [familyId], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MonthlyReviewAction {
  id              String              @id @default(uuid())
  familyId        String
  monthlyReviewId String
  month           String
  title           String
  ownerName       String?
  dueDate         DateTime?
  targetAmount    Decimal?            @db.Decimal(18, 2)
  status          MonthlyActionStatus @default(pending)
  family          Family              @relation(fields: [familyId], references: [id])
  monthlyReview   MonthlyReview       @relation(fields: [monthlyReviewId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([familyId, month])
  @@index([monthlyReviewId, status])
}

model MemberHealthProfile {
  id                         String       @id @default(uuid())
  familyId                   String
  memberId                   String       @unique
  weightTrackingEnabled      Boolean      @default(true)
  exerciseTrackingEnabled    Boolean      @default(true)
  glucoseTrackingEnabled     Boolean      @default(false)
  hba1cTrackingEnabled       Boolean      @default(false)
  medicationTrackingEnabled  Boolean      @default(false)
  targetWeightKg             Decimal?     @db.Decimal(6, 2)
  targetDate                 DateTime?
  weeklyExerciseMinutesGoal  Int          @default(150)
  weeklyStrengthSessionsGoal Int          @default(2)
  strengthExerciseGoals      Json?
  dailyStepsGoal             Int          @default(8000)
  glucoseIntervalDays        Int          @default(7)
  glucoseLowThreshold        Decimal      @default(3.9) @db.Decimal(5, 2)
  glucoseTargets             Json?
  hba1cTargetMax             Decimal?     @db.Decimal(4, 2)
  family                     Family       @relation(fields: [familyId], references: [id])
  member                     FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
}

model BodyMeasurement {
  id         String                 @id @default(uuid())
  familyId   String
  memberId   String
  measuredAt DateTime
  weightKg   Decimal                @db.Decimal(6, 2)
  waistCm    Decimal?               @db.Decimal(6, 2)
  context    BodyMeasurementContext @default(other)
  note       String?
  family     Family                 @relation(fields: [familyId], references: [id])
  member     FamilyMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([memberId, measuredAt])
}

model ExerciseLog {
  id                 String                     @id @default(uuid())
  familyId           String
  memberId           String
  date               DateTime
  type               String
  durationMinutes    Int
  intensity          ExerciseIntensity
  isStrengthTraining Boolean                    @default(false)
  steps              Int?
  estimatedCalories  Int?
  note               String?
  family             Family                     @relation(fields: [familyId], references: [id])
  member             FamilyMember               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  movements          StrengthExerciseMovement[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([memberId, date])
}

model StrengthExerciseMovement {
  id                 String                 @id @default(uuid())
  exerciseLogId      String
  name               String
  metric             StrengthMovementMetric @default(reps)
  sets               Int[]
  variant            String?
  addedWeightKg      Decimal?               @db.Decimal(6, 2)
  assistanceWeightKg Decimal?               @db.Decimal(6, 2)
  note               String?
  sortOrder          Int                    @default(0)
  exerciseLog        ExerciseLog            @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([exerciseLogId, sortOrder])
  @@index([name])
}

model BloodGlucoseRecord {
  id               String            @id @default(uuid())
  familyId         String
  memberId         String
  measuredAt       DateTime
  glucoseMmol      Decimal           @db.Decimal(5, 2)
  context          GlucoseContext
  meal             MealType?
  exerciseRelation ExerciseRelation?
  medicationTaken  Boolean?
  symptoms         String?
  note             String?
  source           GlucoseSource     @default(manual)
  family           Family            @relation(fields: [familyId], references: [id])
  member           FamilyMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([memberId, measuredAt])
  @@index([memberId, context, measuredAt])
}

model Hba1cRecord {
  id             String       @id @default(uuid())
  familyId       String
  memberId       String
  measuredAt     DateTime
  valuePercent   Decimal      @db.Decimal(4, 2)
  facility       String?
  doctorAdvice   String?
  nextReviewDate DateTime?
  family         Family       @relation(fields: [familyId], references: [id])
  member         FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([memberId, measuredAt])
}

model WeeklyHealthReview {
  id         String       @id @default(uuid())
  familyId   String
  memberId   String
  weekStart  DateTime
  good       String?
  obstacle   String?
  nextAction String?
  family     Family       @relation(fields: [familyId], references: [id])
  member     FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([memberId, weekStart])
  @@index([memberId, weekStart])
}

model MedicationPlan {
  id                  String                        @id @default(uuid())
  familyId            String
  memberId            String
  name                String
  specification       String?
  administrationRoute MedicationAdministrationRoute @default(oral)
  frequency           MedicationFrequency           @default(daily)
  weekdays            Int[]                         @default([])
  intervalDays        Int?
  doseUnit            String?
  stockUnit           String
  doseQuantity        Decimal                       @db.Decimal(8, 2)
  inventoryPerDose    Decimal?                      @db.Decimal(8, 2)
  scheduleSlots       Json
  startDate           DateTime
  endDate             DateTime?
  purpose             String?
  instructions        String?
  status              MedicationPlanStatus          @default(active)
  currentStock        Decimal                       @default(0) @db.Decimal(10, 2)
  lowStockDays        Int                           @default(7)
  family              Family                        @relation(fields: [familyId], references: [id])
  member              FamilyMember                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  doseRecords         MedicationDoseRecord[]
  inventory           MedicationInventoryEvent[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([memberId, status])
}

model MedicationDoseRecord {
  id                 String                    @id @default(uuid())
  familyId           String
  memberId           String
  medicationId       String
  scheduledDate      DateTime
  slotId             String
  scheduledLabel     String
  status             MedicationDoseStatus
  quantityUsed       Decimal                   @db.Decimal(8, 2)
  actualDoseQuantity Decimal?                  @db.Decimal(8, 2)
  injectionSite      String?
  takenAt            DateTime?
  note               String?
  family             Family                    @relation(fields: [familyId], references: [id])
  member             FamilyMember              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  medication         MedicationPlan            @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  inventoryEvent     MedicationInventoryEvent?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([medicationId, scheduledDate, slotId])
  @@index([memberId, scheduledDate])
}

model MedicationInventoryEvent {
  id            String                       @id @default(uuid())
  familyId      String
  medicationId  String
  doseRecordId  String?                      @unique
  type          MedicationInventoryEventType
  quantityDelta Decimal                      @db.Decimal(10, 2)
  occurredAt    DateTime
  note          String?
  family        Family                       @relation(fields: [familyId], references: [id])
  medication    MedicationPlan               @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  doseRecord    MedicationDoseRecord?        @relation(fields: [doseRecordId], references: [id], onDelete: Cascade)
  createdAt     DateTime                     @default(now())

  @@index([medicationId, occurredAt])
}

model HealthFollowup {
  id            String               @id @default(uuid())
  familyId      String
  memberId      String
  scheduledAt   DateTime
  hospital      String?
  department    String?
  doctor        String?
  type          String
  tests         Json?
  reminderDays  Int                  @default(7)
  status        HealthFollowupStatus @default(scheduled)
  resultSummary String?
  doctorAdvice  String?
  family        Family               @relation(fields: [familyId], references: [id])
  member        FamilyMember         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([memberId, scheduledAt])
}

model CalendarEvent {
  id                String                     @id @default(uuid())
  familyId          String
  title             String
  type              CalendarEventType
  calendarSystem    CalendarSystem             @default(solar)
  startDate         DateTime                   @db.Date
  endDate           DateTime?                  @db.Date
  startTime         String?
  endTime           String?
  allDay            Boolean                    @default(true)
  recurrence        CalendarRecurrence         @default(none)
  recurrenceEndDate DateTime?                  @db.Date
  lunarMonth        Int?
  lunarDay          Int?
  lunarLeapMonth    Boolean                    @default(false)
  originalYear      Int?
  showCountdown     Boolean                    @default(false)
  reminderDays      Int[]                      @default([])
  location          String?
  note              String?
  status            CalendarEventStatus        @default(scheduled)
  family            Family                     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  participants      CalendarEventParticipant[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([familyId, status, startDate])
  @@index([familyId, type])
}

model CalendarEventParticipant {
  eventId  String
  memberId String
  event    CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member   FamilyMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([eventId, memberId])
  @@index([memberId])
}

model AccountSnapshot {
  id          String   @id @default(uuid())
  familyId    String
  accountId   String
  date        DateTime
  value       Decimal  @db.Decimal(18, 2)
  cashBalance Decimal? @db.Decimal(18, 2)
  family      Family   @relation(fields: [familyId], references: [id])
  account     Account  @relation(fields: [accountId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([accountId, date])
}

model AuditLog {
  id         String   @id @default(uuid())
  familyId   String
  actorName  String
  action     String
  entityType String
  entityId   String
  detail     Json?
  family     Family   @relation(fields: [familyId], references: [id])
  createdAt  DateTime @default(now())
}

model ImportJob {
  id          String   @id @default(uuid())
  familyId    String
  fileName    String
  status      String
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  failedRows  Int      @default(0)
  message     String?
  family      Family   @relation(fields: [familyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
